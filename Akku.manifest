#!r6rs ; -*- scheme -*-
(import (akku format manifest))

;; No `depends` clause and no `scripts` clause, both deliberately.
;;
;; depends: the libraries bind libcurl directly, with no C shim (ADR-0001),
;; and find it on the host when they load (ADR-0002). They need no Scheme
;; library at runtime. chez-srfi is the test suites' (SRFI-64), not a
;; consumer's, so it stays in depends/dev (ADR-0015).
;;
;; scripts: Akku's script mechanism would run a build, but it prompts for
;; approval on every install until the package is vetted in the index, and
;; the prompt can simply be declined, after which no script runs and the
;; install still reports success. There is nothing to build, since no C is
;; compiled (ADR-0001). See chez-cmark-gfm's ADR-0017.
(akku-package ("chez-curl" "0.0.0")
  (synopsis "An HTTP client for Chez Scheme, built on libcurl")
  (authors "Kiyomi Computation Systems LLC")
  (homepage "https://github.com/Kiyomi-Computation-Systems/chez-curl")
  (license "BSD-3-Clause")
  (depends/dev ("chez-srfi" "^0.0.0-akku.181.7879b52")))

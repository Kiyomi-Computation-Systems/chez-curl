(import (chezscheme))
(define (show lib)
  (let ([names (library-exports lib)])
    (printf ";; ~s ~s\n" lib (length names))
    (for-each (lambda (n) (printf "~s ~s\n" lib n))
              (sort (lambda (a b) (string<? (symbol->string a) (symbol->string b))) names))))
(eval '(import (curl)))
(eval '(import (curl unsupported)))
(eval '(import (http-client)))
(show '(curl))
(show '(curl unsupported))
(show '(http-client))

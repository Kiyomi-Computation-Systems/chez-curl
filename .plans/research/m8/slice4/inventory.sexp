(export http-pending-cancel
  (library (http-client)) (kind procedure) (topic "the high level: groups")
  (signature-at "src/http-client.sls:448")
  (signature ((448 "http-pending-cancel : Pending -> Void")))
  (prose ((449 "  ends the call as cancelled: its live transfer cancelled, or its") (450 "  turn or its retry's wait dropped. A call that has ended keeps its") (451 "  answer, which its await gives, but one that failed is no longer") (452 "  raised by the join. It waits for no transfer: a live transfer's") (453 "  cancel is a message, under the engine's mutex; a transfer still") (454 "  queued in the engine, not yet taken in by its thread, is completed") (455 "  at once, under the engine's mutex, into the group's mailbox, under") (456 "  the mailbox's nested inside it; and a call waiting for a slot, or in") (457 "  a retry's wait, has no transfer, and its cancel holds no mutex.")))
  (block-intro ())

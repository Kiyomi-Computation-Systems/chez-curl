(export make-http-session
  (library (http-client)) (kind procedure) (topic "the high level: sessions")
  (signature-at "src/http-client.sls:160")
  (signature ((160 "make-http-session : Any ... -> Session")))
  (prose ((161 "(make-http-session KEY VALUE ...): a session, with these keys, each") (162 "once at most, each left out taking the low level's default, as") (163 "make-curl-request takes them: headers, user-agent, timeout-ms,") (164 "connect-timeout-ms, body-limit, ca-file, verify, proxy, http-version,") (165 "credentials, which a redirect to another origin drops, and which a") (166 "streamed call, call-with-response-port's or a producer's, takes as") (167 "Basic or Bearer alone, digest-with-stream, proxy-ca-file and") (168 "proxy-verify; a call's value replaces its session's, but a call that") (169 "names its own proxy drops the session's proxy-ca-file and") (170 "proxy-verify; and three of the high level's own:") (171 "  redirects        the most redirects a call follows, an exact") (172 "                   natural; or #f, which follows none and answers the") (173 "                   redirect; 20") (174 "  allow-downgrade  whether a redirect from https to http is followed,") (175 "                   a boolean; #f (ADR-0027)") (176 "  retry            a policy, made by make-http-retry, that a call") (177 "                   retries by; or #f, none; #f (ADR-0026)") (178 "  cookies          whether the session keeps cookies: #t makes a jar") (179 "                   on its engine, (curl)'s make-curl-cookie-jar, which") (180 "                   every call of the session carries, every hop of a") (181 "                   redirect among them, another origin's too, and its") (182 "                   close frees; a boolean; #f, none (ADR-0035). No call") (183 "                   takes it. Beside it a Cookie or Host header, the") (184 "                   session's or a call's, in any A to Z case, is") (185 "                   refused, (curl)'s cookie-beside-jar") (186 "A key it does not take, one given twice, and one with no value are") (187 "refused by name, as &http-request-error; then redirects,") (188 "allow-downgrade, retry and cookies, as &http-request-error,") (189 "not-a-redirect-count, not-a-boolean, not-a-retry-policy and") (190 "not-a-boolean; then each other value, as make-curl-request refuses") (191 "it; and only then is its engine made, so a refusal leaves none. With") (192 "cookies, its jar is made then, and a session's Cookie or Host header") (193 "refused: either refusal, and a jar that fails to be made, stops the") (194 "engine it made, and leaves as it was raised. Each session draws its jitter") (195 "from a generator of its own, under a mutex of its own, so threads may") (196 "share it.")))
  (block-intro ())
  (group (make-http-session http-session? http-session-close call-with-http-session))
  (section (159 "sessions (ADR-0025)"))

(export http-session-close
  (library (http-client)) (kind procedure) (topic "the high level: sessions")
  (signature-at "src/http-client.sls:198")
  (signature ((198 "http-session-close : Session -> Void")))
  (prose ((199 "Stops the session's engine: each call in flight ends as stopped, and a") (200 "later call raises the engine's &curl-engine-error. A second close") (201 "returns. It does not drain. A second escape, a Ctrl-C or a timer's") (202 "handler, that lands as the close starts can leave the engine running") (203 "until the process exits (ADR-0025, amended 2026-10-27), as a second") (204 "Ctrl-C during a group's join leaves its tokens live (the M5 plan,") (205 "section 3.7).")))
  (block-intro ())
  (group (make-http-session http-session? http-session-close call-with-http-session))
  (section (159 "sessions (ADR-0025)"))
  (raises ("&curl-library-unavailable" "invalid-override not-found load-failed below-floor no-ssl missing-api" "src/curl/private/native.sls:200-203 (raised again at every later reference); discovery.sls:68,81; native.sls:310,574,588,615,707; verify.sls:36,41,61,64" "at the first reference to the binding in a program, before the program's body: logs/load-probe.txt") ("assertion-violation" "" "src/http-client.sls:595-596, 685" "not a session") ("(curl-engine-stop's refusals)" "" "src/http-client.sls:686" "inside a critical section"))
  (comment-vs-code "agree, as far as read")
  (cites ((203 "ADR-0025") (203 "2026-10-27") (204 "the M5 plan") (159 "ADR-0025"))))

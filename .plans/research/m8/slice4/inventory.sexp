(export curl-cookie-jar-close!
  (library (curl)) (kind procedure) (topic "the low level: jars")
  (signature-at "src/curl.sls:359")
  (signature ((359 "curl-cookie-jar-close! : Jar -> Void")))
  (prose ((360 "Closes the jar: freed at once, or once the last transfer that holds it") (361 "ends. A later submit with it is refused, cookie-jar-closed, and so are") (362 "its read-out and its load. A second close does nothing.")))
  (block-intro ((322 "A jar is an engine's: one curl_share of cookies, made, read, loaded and") (323 "freed on the engine's thread, by message. Each procedure below waits for") (324 "the engine to carry its message out, with no bound, as curl-engine-stop") (325 "waits, and none may run inside a critical section. A jar of an engine") (326 "stopping, stopped or failed is refused as a submit to it is: a stop") (327 "frees every jar.")))
  (group (make-curl-cookie-jar curl-cookie-jar? curl-cookie-jar-cookies curl-cookie-jar-load! curl-cookie-jar-close!))
  (section (321 "the cookie jar (ADR-0035)"))
  (raises ("&curl-library-unavailable" "invalid-override not-found load-failed below-floor no-ssl missing-api" "src/curl/private/native.sls:200-203 (raised again at every later reference); discovery.sls:68,81; native.sls:310,574,588,615,707; verify.sls:36,41,61,64" "at the first reference to the binding in a program, before the program's body: logs/load-probe.txt") ("assertion-violation" "" "src/curl/private/engine.sls:1517-1518" "not a jar; inside a critical section") ("&curl-engine-error" "stopped failed" "src/curl/private/engine.sls:1426-1440" "the jar's engine stopping, stopped or failed"))
  (comment-vs-code "agree, as far as read")
  (cites ((321 "ADR-0035"))))
(export curl-cookie-jar-cookies
  (library (curl)) (kind procedure) (topic "the low level: jars")
  (signature-at "src/curl.sls:331")
  (signature ((331 "curl-cookie-jar-cookies : Jar -> (Listof String)")))
  (prose ((332 "The jar's cookies, as Netscape lines, each a Latin-1 string, one char") (333 "per byte: DOMAIN TAILMATCH PATH SECURE EXPIRY NAME VALUE, tab-separated,") (334 "#HttpOnly_ before an HttpOnly cookie's domain, in libcurl's order,") (335 "which moves: compare them sorted. By version some are lines a load") (336 "refuses: 7.85.0 lists a tab in a name, a value or a server's Path as") (337 "eight fields; 7.85.0 and 8.5.0 a server's Path=, Path=TRUE, Path=FALSE") (338 "or a path that is not absolute as given; and 7.85.0, 8.20.0 and 8.23.0") (339 "a server's cookie whose name starts __Secure- or __Host- in another") (340 "case than the prefix's own, beside fields the prefix does not allow,") (341 "which 8.5.0 drops. 7.85.0 and 8.5.0 list a deleted cookie, with expiry") (342 "1, and a loaded one whose expiry has passed, until a cookie is added.")))
  (block-intro ((322 "A jar is an engine's: one curl_share of cookies, made, read, loaded and") (323 "freed on the engine's thread, by message. Each procedure below waits for") (324 "the engine to carry its message out, with no bound, as curl-engine-stop") (325 "waits, and none may run inside a critical section. A jar of an engine") (326 "stopping, stopped or failed is refused as a submit to it is: a stop") (327 "frees every jar.")))
  (group (make-curl-cookie-jar curl-cookie-jar? curl-cookie-jar-cookies curl-cookie-jar-load! curl-cookie-jar-close!))
  (section (321 "the cookie jar (ADR-0035)"))
  (raises ("&curl-library-unavailable" "invalid-override not-found load-failed below-floor no-ssl missing-api" "src/curl/private/native.sls:200-203 (raised again at every later reference); discovery.sls:68,81; native.sls:310,574,588,615,707; verify.sls:36,41,61,64" "at the first reference to the binding in a program, before the program's body: logs/load-probe.txt") ("assertion-violation" "" "src/curl/private/engine.sls:1483-1484" "not a jar; inside a critical section") ("&curl-engine-error" "stopped failed" "src/curl/private/engine.sls:1426-1440" "the jar's engine stopping, stopped or failed") ("&curl-request-error" "cookie-jar-closed" "src/curl/private/engine.sls:1625, 1637-1639" "field cookie-jar") ("&error (Chez's, no &curl-error)" "" "src/curl/private/transfer.sls:2916-2918" "CURLINFO_COOKIELIST answered a code"))
  (comment-vs-code "partly: a CURLINFO_COOKIELIST code raises Chez's &error (transfer.sls:2916-2918); the public comment does not say so")
  (cites ((321 "ADR-0035"))))
(export curl-cookie-jar-load!
  (library (curl)) (kind procedure) (topic "the low level: jars")
  (signature-at "src/curl.sls:343")
  (signature ((343 "curl-cookie-jar-load! : Jar (Listof String) -> Void")))
  (prose ((344 "Loads the lines, in order, once every one is checked: one not in the") (345 "form a read-out writes is refused, &curl-request-error cookie-line,") (346 "naming its index from 0, never its text, and nothing is loaded. That") (347 "form: seven tab-separated fields, none holding a control char, U+0000") (348 "to U+001F or U+007F; the domain, after an optional #HttpOnly_, neither") (349 "empty nor starting with #, nor the line starting Set-Cookie:; a dot") (350 "before the domain exactly when the tail-match field is TRUE; the") (351 "tail-match and secure fields TRUE or FALSE; the path starting with /;") (352 "the expiry decimal digits, at most 9223372036854775807; a name; no ;") (353 "in the name or the value, and no = in the name; the name and value at") (354 "most 4,096 chars together; a name starting __Secure- or __Host-, in") (355 "any A to Z case, only beside a secure field TRUE, and for __Host- the") (356 "path / and the tail-match FALSE; no char above U+00FF. A") (357 "load costs about n^2 on the engine's thread, while its other transfers") (358 "wait: 10,000 lines 0.24 to 0.50 s, 50,000 up to 27 s.")))
  (block-intro ((322 "A jar is an engine's: one curl_share of cookies, made, read, loaded and") (323 "freed on the engine's thread, by message. Each procedure below waits for") (324 "the engine to carry its message out, with no bound, as curl-engine-stop") (325 "waits, and none may run inside a critical section. A jar of an engine") (326 "stopping, stopped or failed is refused as a submit to it is: a stop") (327 "frees every jar.")))
  (group (make-curl-cookie-jar curl-cookie-jar? curl-cookie-jar-cookies curl-cookie-jar-load! curl-cookie-jar-close!))
  (section (321 "the cookie jar (ADR-0035)"))
  (raises ("&curl-library-unavailable" "invalid-override not-found load-failed below-floor no-ssl missing-api" "src/curl/private/native.sls:200-203 (raised again at every later reference); discovery.sls:68,81; native.sls:310,574,588,615,707; verify.sls:36,41,61,64" "at the first reference to the binding in a program, before the program's body: logs/load-probe.txt") ("assertion-violation" "" "src/curl/private/engine.sls:1501-1502; transfer.sls:2844-2853" "not a jar; inside a critical section; lines not a list of strings") ("&curl-request-error" "cookie-line" "src/curl/private/transfer.sls:2854-2862" "field lines, value the line's index; nothing loaded") ("&curl-engine-error" "stopped failed" "src/curl/private/engine.sls:1426-1440" "the jar's engine stopping, stopped or failed") ("&curl-request-error" "cookie-jar-closed" "src/curl/private/engine.sls:1629, 1637-1639" "") ("&error (Chez's, no &curl-error)" "" "src/curl/private/transfer.sls:2895-2897" "CURLOPT_COOKIELIST answered a code; the lines before it loaded"))
  (comment-vs-code "partly: a COOKIELIST code raises Chez's &error (transfer.sls:2895-2897), not a chez-curl condition; the public comment does not say so")
  (cites ((321 "ADR-0035"))))

  (signature ((450 "curl-token-put-piece! : Token Bytevector [Natural] -> (U #t #f 'done)")))
  (prose ((451 "The piece, a bytevector of a byte or more, copied into the buffer,") (452 "waiting while it is full, at most the milliseconds given, when given:") (453 "#t once taken, #f once they pass, done once the transfer has ended,") (454 "the piece not taken. A piece past the body-length is refused,") (455 "&curl-request-error, body-length-mismatch, and fails the transfer") (456 "with that reason; a put after the end, on a live token, is an") (457 "assertion violation.")))
  (block-intro ((436 "A token whose request has body stream takes its body from puts, into") (437 "a buffer of 64 KiB. libcurl asks for it with the request's head, or") (438 "once it has sent it, by version; an empty buffer pauses the transfer's sending, and a put or the") (439 "end resumes it. It is sent at most once, on a connection of its own: a") (440 "resend libcurl wants once a byte was handed fails the transfer,") (441 "body-not-replayable. The transfer's timeout runs while the producer") (442 "waits. An answer that ends the transfer early ends the upload: every") (443 "later put answers done, and curl-token-body-count says what was taken.") (444 "Over HTTP/2, a transfer that streams both ways sends only while its") (445 "response is read. A token whose request does not stream its body") (446 "refuses each of these, an assertion violation.")))
  (group (curl-token-room-wait curl-token-put-piece! curl-token-end-body! curl-token-body-count))
  (section (435 "a streamed request body (ADR-0030, ADR-0032)"))
  (raises ("&curl-library-unavailable" "invalid-override not-found load-failed below-floor no-ssl missing-api" "src/curl/private/native.sls:200-203 (raised again at every later reference); discovery.sls:68,81; native.sls:310,574,588,615,707; verify.sls:36,41,61,64" "at the first reference to the binding in a program, before the program's body: logs/load-probe.txt") ("assertion-violation" "" "src/curl/private/engine.sls:578-579" "not a token") ("assertion-violation" "" "src/curl/private/engine.sls:1123-1127" "a token whose request does not stream its body") ("assertion-violation" "" "src/curl/private/engine.sls:1200-1201" "a piece that is no bytevector of a byte or more") ("assertion-violation" "" "src/curl/private/engine.sls:1223-1224" "a put after curl-token-end-body! on a live token") ("assertion-violation" "" "src/curl/private/engine.sls:265-267" "a bound that is no natural number of ms") ("assertion-violation" "" "src/curl/private/engine.sls:1233" "a wait inside a critical section") ("&curl-request-error" "body-length-mismatch" "src/curl/private/engine.sls:1216-1222" "field body-length; the piece not taken; the transfer then fails so"))
  (comment-vs-code "agree, as far as read")
  (cites ((435 "ADR-0030") (435 "ADR-0032"))))

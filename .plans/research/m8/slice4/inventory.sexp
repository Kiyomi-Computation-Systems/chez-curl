(export make-http-retry
  (library (http-client)) (kind procedure) (topic "the high level: redirects and retries")
  (signature-at "src/http-client.sls:352")
  (signature ((352 "make-http-retry : Any ... -> Retry")))
  (prose ((353 "(make-http-retry KEY VALUE ...): a policy, data alone, for a session's") (354 "or a call's retry key, with these keys, each once at most, each left") (355 "out its default:") (356 "  attempts        transfers per step, the first among them, an exact") (357 "                  integer of 1 or more; 3") (358 "  backoff-ms      the first retry's wait, doubling for each later one") (359 "                  of the step, an exact natural; 200") (360 "  max-backoff-ms  the backoff's cap, and the longest Retry-After") (361 "                  waited, an exact natural; 10000") (362 "  jitter          #t waits a uniform share of the backoff, rounded") (363 "                  down to a whole ms (\"full jitter\"), #f the backoff") (364 "                  itself; #t") (365 "  statuses        the statuses retried, exact integers from 400 to") (366 "                  599; (429 503)") (367 "  methods         the methods a status, or a failure after a request") (368 "                  was sent, is retried for, of get, head, post, put,") (369 "                  patch and delete; (get head put delete), which RFC") (370 "                  9110, section 9.2.2, calls idempotent") (371 "A key it does not take, one given twice, and one with no value are") (372 "refused by name, as &http-request-error, as a session's are; then each") (373 "value, in that order, as &http-request-error: not-an-attempt-count,") (374 "not-a-backoff, not-a-boolean, not-a-status-list and not-a-method-list.") (375 "Its lists are copied.")))
  (block-intro ())
  (group (make-http-retry http-retry?))
  (section (351 "the retry policy (ADR-0026)"))

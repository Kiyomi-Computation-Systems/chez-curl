(export curl-token-body-port
  (library (curl)) (kind procedure) (topic "the low level: streams")
  (signature-at "src/curl.sls:419")
  (signature ((419 "curl-token-body-port : Token -> Binary-Input-Port")))
  (prose ((420 "A binary input port over the pieces, made once per token, read and") (421 "closed only on the thread that made it: another thread's close raises") (422 "&curl-wrong-thread, and so does any read of its that needs more than") (423 "the port had buffered; bytes the port had buffered go to whichever") (424 "thread reads them, and a get-bytevector-n, -n! or -all from another") (425 "thread that takes them, then raises, loses them. At the end it answers the end") (426 "for a response, every time, and raises the failure for one that") (427 "failed, every time. Its close cancels the transfer. A port never") (428 "closed leaves its transfer paused until its timeout or its engine's") (429 "stop. A failure raised in get-bytevector-n, -n! or -all loses the") (430 "bytes that call had read; get-bytevector-some, -some! and get-u8 lose") (431 "none.")))
  (block-intro ((390 "A token whose request has a stream-buffer holds its response's body as") (391 "pieces, at most stream-buffer bytes or one chunk of libcurl's, 16 KiB,") (392 "whichever is more, and the piece a reader holds. A full buffer pauses") (393 "the transfer; a read that drains it to half resumes it. Over HTTP/1.1") (394 "the server's writes then stall; over HTTP/2 a paused stream beside an") (395 "active one keeps receiving, into libcurl's memory, up to its window.") (396 "The transfer's timeout runs while it is paused. Each wait answers as") (397 "data and never raises the transfer's failure, which the outcome holds;") (398 "the port alone raises it. A token whose request does not stream its") (399 "response refuses each of these, an assertion violation.")))
  (group (curl-token-head-wait curl-token-head curl-head? curl-head-status curl-head-http-version curl-head-headers curl-head-body-asked? curl-token-next-piece curl-token-body-port))
  (section (389 "a streamed response (ADR-0030)"))
  (raises ("&curl-library-unavailable" "invalid-override not-found load-failed below-floor no-ssl missing-api" "src/curl/private/native.sls:200-203 (raised again at every later reference); discovery.sls:68,81; native.sls:310,574,588,615,707; verify.sls:36,41,61,64" "at the first reference to the binding in a program, before the program's body: logs/load-probe.txt") ("assertion-violation" "" "src/curl/private/engine.sls:578-579" "not a token") ("assertion-violation" "" "src/curl/private/engine.sls:889-893" "a token whose request does not stream its response") ("assertion-violation" "" "src/curl/private/engine.sls:1007-1008" "a second port of the token") ("(its reads) the outcome's condition" "" "src/curl/private/engine.sls:1035-1037" "a transfer that failed, every read after") ("&curl-wrong-thread" "" "src/curl/private/engine.sls:1010-1017" "a read that reaches read!, or a close, from another thread") ("assertion-violation" "" "src/curl/private/engine.sls:1039" "a read that waits inside a critical section"))
  (comment-vs-code "agree, as far as read")
  (cites ((389 "ADR-0030"))))

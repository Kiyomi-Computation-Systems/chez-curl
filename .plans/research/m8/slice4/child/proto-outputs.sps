#!r6rs
;;; proto-outputs.sps: what the proposed examples would print, measured on
;;; one lane before any example exists (M8 slice 4's measurement; not an
;;; example). Under (curl-testing)'s origin, each scenario of examples.md,
;;; its output between (begin NAME) and (end NAME). Run from the root.
(import (rnrs) (only (chezscheme) format) (curl) (http-client) (curl-testing))

(define (show . xs) (for-each display xs) (newline))
(define (lines text)
  (let loop ((i 0) (start 0) (acc '()))
    (cond ((= i (string-length text)) (reverse (if (< start i) (cons (substring text start i) acc) acc)))
          ((char=? (string-ref text i) #\newline) (loop (+ i 1) (+ i 1) (cons (substring text start i) acc)))
          (else (loop (+ i 1) start acc)))))
(define (prefix? p s) (and (>= (string-length s) (string-length p)) (string=? (substring s 0 (string-length p)) p)))
(define (field line name)
  ;; the value of NAME= in a space-separated report line
  (let loop ((ws (let split ((i 0) (start 0) (acc '()))
                   (cond ((= i (string-length line)) (reverse (cons (substring line start i) acc)))
                         ((char=? (string-ref line i) #\space) (split (+ i 1) (+ i 1) (cons (substring line start i) acc)))
                         (else (split (+ i 1) start acc))))))
    (cond ((null? ws) #f)
          ((prefix? (string-append name "=") (car ws)) (substring (car ws) (+ 1 (string-length name)) (string-length (car ws))))
          (else (loop (cdr ws))))))
(define (pattern-bytes n)
  (let ((bv (make-bytevector n))) (do ((i 0 (+ i 1))) ((= i n) bv) (bytevector-u8-set! bv i (mod i 251)))))

(call-with-origin
 (lambda (o)
   (let* ((face (origin-face o 'http))
          (base (string-append "http://" (car face) ":" (number->string (cdr face)))))
     (define (u path) (string-append base path))
     (show "(begin params-and-form)")
     (call-with-http-session 'timeout-ms 10000
       (lambda (s)
         (show (car (lines (http-response-text (http-get s (u "/echo") 'params '(("q" . "chez scheme") ("page" . "2")))))))
         (let ((ls (lines (http-response-text (http-post s (u "/echo") 'form '(("name" . "Ada Lovelace") ("lang" . "Scheme")))))))
           (show (car ls))
           (for-each (lambda (l) (when (prefix? "Content-Type" l) (show l))) ls)
           (show (car (reverse ls))))))
     (show "(end params-and-form)")
     (show "(begin multipart)")
     (call-with-http-session 'timeout-ms 10000
       (lambda (s)
         (let ((ls (lines (http-response-text
                           (http-post s (u "/parts?key=mp-1")
                                      'multipart '(("title" "Holiday")
                                                   ("notes" #vu8(104 105) filename "notes.txt")
                                                   ("doc" (file ".plans/research/m8/slice4/child/data/hello.txt"))
                                                   ("blob" #vu8(1 2 3) type "application/x-thing")))))))
           (show "count=" (field (car ls) "count"))
           (for-each show (cdr ls)))))
     (show "(end multipart)")
     (show "(begin retries)")
     (call-with-http-session 'timeout-ms 10000
                             'retry (make-http-retry 'attempts 3 'backoff-ms 10 'jitter #f 'statuses '(503))
       (lambda (s)
         (let ((r (http-get s (u "/redirect/302?to=/status/200"))))
           (show (http-response-status r) " " (map http-response-status (http-response-history r))))
         (let ((r (http-get s (u "/parts?key=retry-1&fail=2"))))
           (show (http-response-status r))
           (show (http-response-text r)))
         (show (http-response-text (http-get s (u "/seen?key=retry-1"))))))
     (show "(end retries)")
     (show "(begin cookies)")
     (let* ((engine (make-curl-engine)) (jar (make-curl-cookie-jar engine)))
       (let ((r (curl-token-await (curl-submit engine (make-curl-request (u "/cookies?key=jar-1&set=flavour%3Doat") 'cookie-jar jar)))))
         (show (curl-response-status r)))
       (for-each (lambda (l) (write l) (newline)) (list-sort string<? (curl-cookie-jar-cookies jar)))
       (let ((r (curl-token-await (curl-submit engine (make-curl-request (u "/echo") 'cookie-jar jar)))))
         (for-each (lambda (l) (when (prefix? "Cookie" l) (show l)))
                   (lines (utf8->string (curl-response-body r)))))
       (curl-cookie-jar-load! jar (list (string-append "127.0.0.1\tFALSE\t/\tFALSE\t0\tsize\tlarge")))
       (for-each (lambda (l) (write l) (newline)) (list-sort string<? (curl-cookie-jar-cookies jar)))
       (curl-cookie-jar-close! jar)
       (curl-engine-stop engine))
     (show "(end cookies)")
     (show "(begin upload)")
     (let* ((engine (make-curl-engine))
            (n 300000)
            (data (pattern-bytes n))
            (t (curl-submit engine (make-curl-request (u "/sink?key=up-1") 'method 'put 'body 'stream 'body-length n))))
       (let loop ((at 0))
         (when (< at n)
           (let ((k (min 65536 (- n at))))
             (curl-token-put-piece! t (let ((bv (make-bytevector k))) (bytevector-copy! data at bv 0 k) bv))
             (loop (+ at k)))))
       (curl-token-end-body! t)
       (let* ((r (curl-token-await t)) (line (car (lines (utf8->string (curl-response-body r))))))
         (show (curl-response-status r))
         (show line)
         (show "method=" (field line "method") " cl=" (field line "cl") " te=" (field line "te")
               " bytes=" (field line "bytes") " pattern=" (field line "pattern")))
       (curl-engine-stop engine))
     (show "(end upload)")
     (show "(begin download)")
     (call-with-http-session 'timeout-ms 10000
       (lambda (s)
         (call-with-response-port s 'get (u "/pattern/1000000")
           (lambda (r port)
             (show (http-response-status r))
             (let loop ((i 0) (ok #t))
               (let ((bv (get-bytevector-some port)))
                 (if (eof-object? bv)
                     (show i " bytes, pattern " (if ok "ok" "bad"))
                     (loop (+ i (bytevector-length bv))
                           (and ok (let check ((k 0))
                                     (or (= k (bytevector-length bv))
                                         (and (= (bytevector-u8-ref bv k) (mod (+ i k) 251)) (check (+ k 1))))))))))))))
     (show "(end download)")
     (show "(begin group)")
     (call-with-http-session 'timeout-ms 10000
       (lambda (s)
         (show (map http-response-status
                    (http-parallel s (list (list 'get (u "/status/200")) (list 'get (u "/status/201")) (list 'get (u "/status/404"))) 'limit 2)))
         (call-with-request-group s 'limit 2
           (lambda (go)
             (let* ((a (go 'get (u "/status/202"))) (b (go 'get (u "/status/203"))))
               (show (list (http-response-status (http-await a)) (http-response-status (http-await b)))))))))
     (show "(end group)")
     (show "(begin errors)")
     (call-with-http-session 'timeout-ms 10000
       (lambda (s)
         (show (http-response-status (http-get s (u "/status/404"))))
         (show (guard (e ((http-timeout? e) (list 'timeout (http-timeout-timeout-ms e) (curl-timeout? e))))
                 (http-get s (u "/pattern/10?delay=2000") 'timeout-ms 200)))
         (show (guard (e ((curl-too-large? e) (list 'too-large (curl-transfer-error-reason e))))
                 (http-get s (u "/pattern/100000") 'body-limit 1000)))
         (show (guard (e ((curl-request-error? e) (list (curl-request-error-field e) (curl-request-error-reason e))))
                 (curl-request-check (make-curl-request "https://example.invalid/" 'http-version 'http/2-prior-knowledge))))))
     (show "(end errors)"))))

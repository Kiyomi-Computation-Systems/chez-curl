(import (chezscheme) (curl) (http-client) (curl-testing))
(define-syntax try
  (syntax-rules ()
    ((_ label e) (begin (display label) (display " => ")
                        (guard (c (#t (display "RAISED ")
                                      (when (assertion-violation? c) (display "assertion "))
                                      (when (curl-wrong-thread? c) (display "curl-wrong-thread "))
                                      (when (curl-request-error? c) (display (list 'curl-request-error (curl-request-error-field c) (curl-request-error-reason c))))
                                      (when (http-request-error? c) (display (list 'http-request-error (http-request-error-field c) (http-request-error-reason c))))
                                      (when (curl-engine-error? c) (display (list 'curl-engine-error (curl-engine-error-reason c))))
                                      (when (curl-transfer-error? c) (display (list 'curl-transfer-error (curl-transfer-error-reason c) (curl-transfer-error-code c) (curl-transfer-error-request-size c))))
                                      (when (message-condition? c) (display (condition-message c)))))
                          (write e))
                        (newline)))))
(define (on-other-thread thunk)
  (let ((m (make-mutex)) (c (make-condition)) (result #f) (done #f))
    (fork-thread (lambda ()
                   (let ((r (guard (e (#t (list 'raised (if (curl-wrong-thread? e) 'curl-wrong-thread (if (assertion-violation? e) 'assertion 'other)))))
                              (thunk))))
                     (with-mutex m (set! result r) (set! done #t) (condition-signal c)))))
    (with-mutex m (let loop () (unless done (condition-wait c m (make-time 'time-duration 0 5)) (unless done (loop)))))
    result))
(let ((e (make-curl-engine)))
  (define j (make-curl-cookie-jar e))
  (curl-engine-stop e)
  (try "jar close after engine stop" (curl-cookie-jar-close! j)))
(try "http-get inside critical-section" (call-with-http-session (lambda (s) (critical-section (http-get s "http://127.0.0.1:1/")))))
(call-with-origin
 (lambda (o)
   (let* ((f (origin-face o 'http)) (base (string-append "http://" (car f) ":" (number->string (cdr f)))))
     (let ((e (make-curl-engine)))
       (let ((t (curl-submit e (make-curl-request (string-append base "/pattern/300000") 'stream-buffer 1000 'timeout-ms 10000))))
         (curl-token-head-wait t 10000)
         (let ((p (curl-token-body-port t)))
           (try "second body port" (curl-token-body-port t))
           (try "low-level port read on another thread" (on-other-thread (lambda () (get-bytevector-n p 200000))))
           (try "low-level port close on another thread" (on-other-thread (lambda () (close-port p))))
           (close-port p)))
       (let ((t (curl-submit e (make-curl-request base))))
         (try "cancel a done token" (begin (curl-token-await t) (curl-token-cancel t))))
       (curl-engine-stop e))
     (call-with-http-session 'timeout-ms 10000
       (lambda (s)
         (try "high-level port read on another thread"
              (call-with-response-port s 'get (string-append base "/pattern/300000") 'stream-buffer 1000
                (lambda (r p) (on-other-thread (lambda () (get-bytevector-n p 200000))))))
         (try "high-level port close on another thread"
              (call-with-response-port s 'get (string-append base "/pattern/300000") 'stream-buffer 1000
                (lambda (r p) (on-other-thread (lambda () (close-port p))))))
         (try "string body content-type"
              (let ((text (http-response-text (http-post s (string-append base "/echo") 'body "hi"))))
                (filter (lambda (l) (and (> (string-length l) 7) (string-ci=? (substring l 0 8) "content-"))) (let loop ((cs (string->list text)) (cur '()) (out '())) (cond ((null? cs) (reverse (cons (list->string (reverse cur)) out))) ((char=? (car cs) #\newline) (loop (cdr cs) '() (cons (list->string (reverse cur)) out))) (else (loop (cdr cs) (cons (car cs) cur) out)))))))
         (try "form with own content-type"
              (let ((text (http-response-text (http-post s (string-append base "/echo") 'form '(("a" . "b")) 'headers '(("content-type" . "text/x"))))))
                (filter (lambda (l) (and (> (string-length l) 7) (string-ci=? (substring l 0 8) "content-"))) (let loop ((cs (string->list text)) (cur '()) (out '())) (cond ((null? cs) (reverse (cons (list->string (reverse cur)) out))) ((char=? (car cs) #\newline) (loop (cdr cs) '() (cons (list->string (reverse cur)) out))) (else (loop (cdr cs) (cons (car cs) cur) out)))))))
         (try "http-response-url with params" (http-response-url (http-get s (string-append base "/status/200") 'params '(("a" . "b c")))))
         (try "http-response-header any case" (http-response-header (http-get s (string-append base "/status/200")) "CONTENT-length"))
         (try "redirect 0 bound" (guard (c ((http-redirect-error? c) (list (http-redirect-error-reason c) (http-redirect-error-location c)))) (http-get s (string-append base "/redirect/302?to=/status/200") 'redirects 0)))
         (try "redirects #f" (http-response-status (http-get s (string-append base "/redirect/302?to=/status/200") 'redirects #f)))
         (try "exchange on url error" (guard (c ((http-exchange? c) (list (curl-url-error? c) (http-exchange-transfers c)))) (http-get s "http://exa mple.com/"))))))))

(import (chezscheme) (curl) (http-client))
(for-each (lambda (p) (display (car p)) (display ": ") (write (cdr p)) (newline))
  (list (cons 'curl-request-error-reasons curl-request-error-reasons)
        (cons 'curl-transfer-error-reasons curl-transfer-error-reasons)
        (cons 'curl-library-unavailable-reasons curl-library-unavailable-reasons)
        (cons 'curl-engine-error-reasons curl-engine-error-reasons)
        (cons 'http-request-error-reasons http-request-error-reasons)
        (cons 'http-redirect-error-reasons http-redirect-error-reasons)
        (cons 'http-group-error-reasons http-group-error-reasons)))
(display (length curl-request-error-reasons)) (newline)

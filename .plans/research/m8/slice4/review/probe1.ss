(import (chezscheme) (curl) (http-client) (curl private counters))
(define-syntax try
  (syntax-rules ()
    ((_ label e) (begin (display label) (display " => ")
                        (guard (c (#t (display "RAISED ")
                                      (when (assertion-violation? c) (display "assertion "))
                                      (when (curl-request-error? c) (display (list 'curl-request-error (curl-request-error-field c) (curl-request-error-reason c))))
                                      (when (http-request-error? c) (display (list 'http-request-error (http-request-error-field c) (http-request-error-reason c))))
                                      (when (curl-engine-error? c) (display (list 'curl-engine-error (curl-engine-error-reason c))))
                                      (when (curl-wrong-thread? c) (display 'wrong-thread))
                                      (when (message-condition? c) (display (condition-message c)))))
                          (write e))
                        (newline)))))
(define r (make-curl-request "http://127.0.0.1:1/"))
(try "print request" r)
(try "curl-request-with no keys" (curl-request-url (curl-request-with r)))
(define e (make-curl-engine))
(try "print engine" e)
(define t (curl-submit e r))
(try "print token" t)
(try "token-wait 0" (curl-token-wait t 0))
(define mb (make-curl-mailbox))
(try "print mailbox" mb)
(try "mailbox-take 0" (curl-mailbox-take mb 0))
(define j (make-curl-cookie-jar e))
(try "print jar" j)
(try "url eq copy?" (let ((u (string-copy "http://127.0.0.1:1/x"))) (let ((rq (make-curl-request u))) (eq? u (curl-request-url rq)))))
(try "headers eq copy?" (let ((h (list (cons "X-A" "b")))) (let ((rq (make-curl-request "http://h/" 'headers h))) (eq? h (curl-request-headers rq)))))
(try "header string eq copy?" (let ((h (list (cons "X-A" (string-copy "b"))))) (let ((rq (make-curl-request "http://h/" 'headers h))) (eq? (cdar h) (cdar (curl-request-headers rq))))))
(try "ca-file eq copy?" (let ((f (string-copy "/tmp/ca.pem"))) (let ((rq (make-curl-request "http://h/" 'ca-file f))) (eq? f (curl-request-ca-file rq)))))
(try "user-agent eq copy?" (let ((f (string-copy "ua"))) (let ((rq (make-curl-request "http://h/" 'user-agent f))) (eq? f (curl-request-user-agent rq)))))
(try "body bv eq copy?" (let ((b (bytevector 1 2))) (let ((rq (make-curl-request "http://h/" 'method 'post 'body b))) (eq? b (curl-request-body rq)))))
(try "cancel" (curl-token-cancel t))
(try "await cancelled" (guard (c ((curl-transfer-error? c) (list (curl-transfer-error-reason c) (curl-transfer-error-request-size c)))) (curl-token-await t)))
(curl-cookie-jar-close! j)
(curl-cookie-jar-close! j)
(try "jar read after close" (curl-cookie-jar-cookies j))
(curl-engine-stop e)
(try "second stop" (curl-engine-stop e))
(try "submit after stop" (curl-submit e r))
(try "jar make on stopped" (make-curl-cookie-jar e))
(try "session cookies on no-cookie session" (call-with-http-session (lambda (s) (http-session-cookies s))))
(try "session cookie-beside-jar" (make-http-session 'cookies #t 'headers '(("Cookie" . "a=b"))))
(try "session host beside jar" (make-http-session 'cookies #t 'headers '(("HOST" . "a"))))
(try "counts after refusal" (native-counts))
(try "get with form" (call-with-http-session (lambda (s) (http-get s "http://127.0.0.1:1/" 'form '(("a" . "b"))))))
(try "get with multipart" (call-with-http-session (lambda (s) (http-get s "http://127.0.0.1:1/" 'multipart '(("a" "b"))))))
(try "print session" (call-with-http-session (lambda (s) (format "~s" s))))
(try "print retry" (make-http-retry))
(try "header beside call ua" (call-with-http-session 'headers '(("User-Agent" . "S")) (lambda (s) 1)))
(try "make-http-retry statuses 300" (make-http-retry 'statuses '(300)))
(try "redirects 0 session" (make-http-session 'redirects 0))
(try "body-length 0 with stream" (curl-request-body-length (make-curl-request "http://h/" 'method 'put 'body 'stream 'body-length 0)))
(try "stream-buffer 1" (curl-request-stream-buffer (make-curl-request "http://h/" 'stream-buffer 1)))
(try "timeout 0" (make-curl-request "http://h/" 'timeout-ms 0))
(try "body-limit 0" (curl-request-body-limit (make-curl-request "http://h/" 'body-limit 0)))
(try "ca-file empty" (make-curl-request "http://h/" 'ca-file ""))
(try "ca-file pkcs11" (make-curl-request "http://h/" 'ca-file "PKCS11:x"))
(try "user-agent empty" (make-curl-request "http://h/" 'user-agent ""))
(try "header value VT" (make-curl-request "http://h/" 'headers (list (cons "X" (string #\vt #\a)))))
(try "header value trailing tab" (make-curl-request "http://h/" 'headers (list (cons "X" (string #\a #\tab)))))
(try "two Host" (make-curl-request "http://h/" 'headers '(("Host" . "a") ("host" . "b"))))
(try "UA header beside ua" (make-curl-request "http://h/" 'user-agent "x" 'headers '(("user-agent" . "y"))))
(try "transfer-encoding" (make-curl-request "http://h/" 'headers '(("Transfer-Encoding" . "chunked"))))
(try "proxy-authorization" (make-curl-request "http://h/" 'headers '(("proxy-authorization" . "x"))))
(try "credentials colon basic user" (make-curl-request "http://h/" 'credentials '(basic "a:b" "c")))
(try "credentials colon digest user" (curl-request-credentials (make-curl-request "http://h/" 'credentials '(digest "a:b" "c"))))
(try "credentials empty bearer" (make-curl-request "http://h/" 'credentials '(bearer "")))
(try "credentials basic empty user only" (curl-request-credentials (make-curl-request "http://h/" 'credentials '(basic "" "p"))))
(try "digest with stream-buffer" (make-curl-request "http://h/" 'credentials '(digest "a" "b") 'stream-buffer 10))
(try "creds beside authorization" (make-curl-request "http://h/" 'credentials '(bearer "t") 'headers '(("authorization" . "x"))))
(try "url-error input string" (guard (c ((curl-url-error? c) (list (curl-url-error-reason c) (curl-url-error-code c)))) (curl-url-part "http://exa mple.com/" 'host)))
(try "url-part bad part" (curl-url-part "http://h/" 'bogus))
(try "url 8000001 ascii" (guard (c ((curl-url-error? c) (list (curl-url-error-reason c) (curl-url-error-code c)))) (curl-url-part (string-append "http://h/" (make-string 8000000 #\a)) 'host)))

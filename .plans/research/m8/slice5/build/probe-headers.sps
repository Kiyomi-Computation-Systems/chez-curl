#!r6rs
;;; probe-headers.sps: what a call sends, read through the origin's /echo,
;;; for the Headers and JSON page. Run from the repository's root:
;;;   $CHEZ --libdirs src:tests:build/scheme-libs --program .plans/research/m8/slice5/build/probe-headers.sps
(import (rnrs) (http-client) (curl) (curl-testing))

(define (show-echo label response)
  (display "== ") (display label) (newline)
  (display (http-response-text response))
  (newline))

(define (refusal thunk)
  (guard (e ((curl-request-error? e)
             (list 'refused (curl-request-error-field e) (curl-request-error-reason e)))
            ((http-request-error? e)
             (list 'http-refused (http-request-error-field e) (http-request-error-reason e)))
            (#t (list 'raised (describe e))))
    (thunk)
    'accepted))

(call-with-origin
 (lambda (o)
   (let* ((face (origin-face o 'http))
          (base (string-append "http://" (car face) ":" (number->string (cdr face))))
          (url (string-append base "/echo")))
     (call-with-http-session 'timeout-ms 10000
       (lambda (s)
         (show-echo "get, nothing named" (http-get s url))
         (show-echo "head is not shown: no body" (http-get s url 'params '(("as" . "get"))))
         (show-echo "post, a bytevector body" (http-post s url 'body (string->utf8 "{}")))
         (show-echo "post, a string body" (http-post s url 'body "{}"))
         (show-echo "post, no body" (http-post s url))
         (show-echo "put, a body" (http-put s url 'body "x"))
         (show-echo "delete, no body" (http-delete s url))
         (show-echo "post, a form" (http-post s url 'form '(("a" . "b"))))
         (show-echo "get, Accept empty" (http-get s url 'headers '(("Accept" . ""))))
         (show-echo "get, X-Empty empty" (http-get s url 'headers '(("X-Empty" . ""))))
         (show-echo "get, user-agent probe/1" (http-get s url 'user-agent "probe/1"))
         (show-echo "get, User-Agent header hdr/1" (http-get s url 'headers '(("User-Agent" . "hdr/1"))))
         (show-echo "get, Host header" (http-get s url 'headers '(("Host" . "example.test"))))
         (show-echo "get, accept lower case" (http-get s url 'headers '(("accept" . "text/plain"))))
         (show-echo "post, Content-Type empty" (http-post s url 'body "{}" 'headers '(("Content-Type" . ""))))
         (show-echo "post, Expect empty" (http-post s url 'body "{}" 'headers '(("Expect" . ""))))
         (show-echo "post, a producer, no body-length"
                    (let ((sent #f))
                      (http-post s url 'body (lambda () (if sent (eof-object) (begin (set! sent #t) (string->utf8 "abc")))))))
         (show-echo "post, a producer, body-length 3"
                    (let ((sent #f))
                      (http-post s url 'body-length 3
                                 'body (lambda () (if sent (eof-object) (begin (set! sent #t) (string->utf8 "abc")))))))
         (let* ((h2 (origin-face o 'h2c))
                (h2-url (string-append "http://" (car h2) ":" (number->string (cdr h2)) "/echo")))
           (show-echo "h2c get, prior knowledge, nothing named" (http-get s h2-url 'http-version 'http/2-prior-knowledge))
           (show-echo "h2c post, a body" (http-post s h2-url 'http-version 'http/2-prior-knowledge 'body "{}")))))
     (call-with-http-session 'timeout-ms 10000
                             'headers '(("X-A" . "1") ("Accept" . "application/json") ("User-Agent" . "sess/1"))
       (lambda (s)
         (show-echo "session X-A, Accept, User-Agent; call nothing" (http-get s url))
         (show-echo "session's; call x-a 2" (http-get s url 'headers '(("x-a" . "2"))))
         (show-echo "session's; call user-agent call/1" (http-get s url 'user-agent "call/1"))
         (show-echo "session's; call Accept empty" (http-get s url 'headers '(("Accept" . ""))))))
     (call-with-http-session 'timeout-ms 10000 'user-agent "sess-agent/1"
       (lambda (s)
         (show-echo "session user-agent; call nothing" (http-get s url))
         (show-echo "session user-agent; call User-Agent header" (http-get s url 'headers '(("User-Agent" . "hdr/2"))))))
     (let ((engine (make-curl-engine)))
       (for-each
        (lambda (row)
          (display "== ") (display (car row)) (newline)
          (display (utf8->string
                    (curl-response-body
                     (curl-token-await (curl-submit engine (apply make-curl-request url 'timeout-ms 10000 (cdr row)))))))
          (newline))
        (list (list "low level get, X-Low" 'headers '(("X-Low" . "1")))
              (list "low level post, no body" 'method 'post)
              (list "low level post, bytes" 'method 'post 'body (string->utf8 "{}"))
              (list "low level get, two Accept" 'headers '(("Accept" . "a") ("Accept" . "b")))))
       (curl-engine-stop engine))
     (display "== refusals") (newline)
     (for-each
      (lambda (row)
        (write (list (car row) (refusal (cadr row))))
        (newline))
      (list (list "name with a space" (lambda () (make-curl-request url 'headers '(("X A" . "1")))))
            (list "empty name" (lambda () (make-curl-request url 'headers '(("" . "1")))))
            (list "value CR" (lambda () (make-curl-request url 'headers '(("X" . "a\rb")))))
            (list "value NUL" (lambda () (make-curl-request url 'headers '(("X" . "a\x0;b")))))
            (list "value above U+00FF" (lambda () (make-curl-request url 'headers '(("X" . "\x100;")))))
            (list "value leading space" (lambda () (make-curl-request url 'headers '(("X" . " a")))))
            (list "value trailing tab" (lambda () (make-curl-request url 'headers '(("X" . "a\t")))))
            (list "value inner space" (lambda () (make-curl-request url 'headers '(("X" . "a b")))))
            (list "value Latin-1 e acute" (lambda () (make-curl-request url 'headers '(("X" . "caf\xe9;")))))
            (list "User-Agent beside user-agent" (lambda () (make-curl-request url 'headers '(("user-agent" . "a")) 'user-agent "b")))
            (list "two Host" (lambda () (make-curl-request url 'headers '(("Host" . "a") ("host" . "b")))))
            (list "Content-Length" (lambda () (make-curl-request url 'headers '(("content-length" . "1")))))
            (list "Transfer-Encoding" (lambda () (make-curl-request url 'headers '(("Transfer-Encoding" . "chunked")))))
            (list "Proxy-Authorization" (lambda () (make-curl-request url 'headers '(("Proxy-Authorization" . "Basic x")))))
            (list "user-agent empty" (lambda () (make-curl-request url 'user-agent "")))
            (list "user-agent leading space" (lambda () (make-curl-request url 'user-agent " a")))
            (list "high level: name with a space" (lambda () (call-with-http-session (lambda (s) (http-get s url 'headers '(("X A" . "1")))))))
            (list "session: Content-Length" (lambda () (call-with-http-session 'headers '(("Content-Length" . "1")) (lambda (s) #t))))
            (list "two Accept, allowed?" (lambda () (make-curl-request url 'headers '(("Accept" . "a") ("Accept" . "b"))))))))))

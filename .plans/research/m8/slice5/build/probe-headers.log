== refusals
("name with a space" (refused header-name not-a-token))
("empty name" (refused header-name not-a-token))
("value CR" (refused header-value line-break))
("value NUL" (refused header-value embedded-nul))
("value above U+00FF" (refused header-value not-latin-1))
("value leading space" (refused header-value surrounding-whitespace))
("value trailing tab" (refused header-value surrounding-whitespace))
("value inner space" accepted)
("value Latin-1 e acute" accepted)
("User-Agent beside user-agent" (refused header-name duplicates-field))
("two Host" (refused header-name duplicates-field))
("Content-Length" (refused header-name framing-header))
("Transfer-Encoding" (refused header-name framing-header))
("Proxy-Authorization" (refused header-name proxy-authorization-header))
("user-agent empty" (raised "Exception in make-curl-request: a user agent is a non-empty string or #f with irritant (kind string)"))
("user-agent leading space" (refused user-agent surrounding-whitespace))
("high level: name with a space" (refused header-name not-a-token))
("session: Content-Length" (refused header-name framing-header))
("two Accept, allowed?" accepted)

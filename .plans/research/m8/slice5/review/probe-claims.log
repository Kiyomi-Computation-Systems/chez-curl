("call user-agent and User-Agent header" (refused header-name duplicates-field))
("call user-agent \"\"" (assertion "Exception in make-curl-request: a user agent is a non-empty string or #f with irritant (kind string)"))
("call headers not string pairs" (assertion "Exception in make-curl-request: headers are a list of (NAME . VALUE) strings with irritant (kind list)"))
("high level producer beside Expect: 100-continue" (refused stream-buffer stream-with-rounds))
("high level bytes body beside Expect: 100-continue" accepted)
("session user-agent \"\"" (assertion "Exception in make-curl-request: a user agent is a non-empty string or #f with irritant (kind string)"))
("session headers not string pairs" (assertion "Exception in make-curl-request: headers are a list of (NAME . VALUE) strings with irritant (kind list)"))
("session two Host" (refused header-name duplicates-field))
("session user-agent beside User-Agent header" (refused header-name duplicates-field))
("low level body stream, no stream-buffer, Expect: 100-continue" accepted)
("low level stream-buffer, Expect: 100-continue" (refused stream-buffer stream-with-rounds))
("low level two Host, different case" (refused header-name duplicates-field))
("low level a name holding U+00E9" (refused header-name not-a-token))
("low level a name holding a colon" (refused header-name not-a-token))
("low level a value of a lone space" (refused header-value surrounding-whitespace))
("low level a value with VT inside" accepted)
("low level a value ending in FF" (refused header-value surrounding-whitespace))

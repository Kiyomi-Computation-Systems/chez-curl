+      (cond (empty (sink-hstart-set! sink #t))
+            (status (sink-hstart-set! sink #f))
+            (else (sink-hstart-set! sink #f)
+                  (sink-hlines-set! sink (+ (sink-hlines sink) 1))))
+      (and (<= (sink-hlines sink) header-line-cap) (<= (sink-hbytes sink) header-byte-cap))))

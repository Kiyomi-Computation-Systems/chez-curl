;; C4. When write! is called, with what, and how often.
(import (chezscheme))

(define (say fmt . args)
  (apply printf fmt args)
  (newline)
  (flush-output-port (current-output-port)))

;; A port whose write! logs #(start count bv answered) and answers by
;; (ANSWER start count), default count. Returns the port, a thunk giving
;; the calls oldest first, a setter for ANSWER, and a thunk giving the
;; close calls.
(define (make-logging-port)
  (let ([calls '()] [answer (lambda (start count) count)] [closes 0])
    (define (write! bv start count)
      (let ([a (answer start count)])
        (set! calls (cons (vector start count bv a) calls))
        a))
    (values (make-custom-binary-output-port "c4" write! #f #f
              (lambda () (set! closes (fx+ closes 1))))
            (lambda () (reverse calls))
            (lambda (f) (set! answer f))
            (lambda () closes))))

(define (report label p calls before caller)
  (let ([mine (list-tail (calls) before)])
    (say "~a: write! calls ~s; output-index after ~s" label (length mine)
         (if (port-closed? p) 'closed (binary-port-output-index p)))
    (let loop ([ls mine] [i 1])
      (unless (null? ls)
        (let* ([c (car ls)] [bv (vector-ref c 2)])
          (say "~a: call ~s start ~s count ~s bvlen ~s bv ~a answered ~s" label i
               (vector-ref c 0) (vector-ref c 1) (bytevector-length bv)
               (cond
                 [(and (not (port-closed? p)) (eq? bv (binary-port-output-buffer p))) "port-buffer"]
                 [(and caller (eq? bv caller)) "caller-bv"]
                 [else "other"])
               (vector-ref c 3)))
        (loop (cdr ls) (fx+ i 1))))))

(define (bytes n) (let ([bv (make-bytevector n)])
                    (do ([i 0 (fx+ i 1)]) ((fx= i n) bv)
                      (bytevector-u8-set! bv i (fxand i 255)))))

(let-values ([(p calls set-answer! closes) (make-logging-port)])
  (say "new port: output-size ~s output-buffer length ~s"
       (binary-port-output-size p) (bytevector-length (binary-port-output-buffer p)))
  (do ([i 0 (fx+ i 1)]) ((fx= i 127)) (put-u8 p i))
  (report "127 put-u8" p calls 0 #f)
  (let ([n (length (calls))])
    (put-u8 p 127)
    (report "128th put-u8" p calls n #f))
  (let ([n (length (calls))])
    (flush-output-port p)
    (report "flush an empty buffer" p calls n #f))
  (let ([n (length (calls))] [bv (bytes 256)])
    (put-bytevector p bv)
    (report "put-bytevector 256, buffer empty" p calls n bv))
  (let ([n (length (calls))] [bv (bytes 257)])
    (put-bytevector p bv)
    (report "put-bytevector 257, buffer empty" p calls n bv))
  (let ([n (length (calls))] [bv (bytes 200)])
    (put-bytevector p bv)
    (report "put-bytevector 200, buffer empty" p calls n bv))
  (let ([n (length (calls))] [bv (bytes 127)])
    (put-bytevector p bv)
    (report "put-bytevector 127, buffer empty" p calls n bv)
    (flush-output-port p))
  (let ([n (length (calls))] [bv (bytes 100)])
    (put-bytevector p bv)
    (report "put-bytevector 100, buffer empty" p calls n bv))
  (let ([n (length (calls))])
    (flush-output-port p)
    (report "flush 100 buffered" p calls n #f))
  (let ([n (length (calls))] [bv1 (bytes 50)] [bv2 (bytes 100)])
    (put-bytevector p bv1)
    (put-bytevector p bv2)
    (report "put-bytevector 50 then 100" p calls n bv2))
  ;; A write! that answers 0 once, then everything.
  (let ([n (length (calls))] [zeros 1])
    (put-bytevector p (bytes 10))
    (set-answer! (lambda (start count)
                   (if (fx> zeros 0) (begin (set! zeros (fx- zeros 1)) 0) count)))
    (flush-output-port p)
    (report "flush 10, write! answers 0 once" p calls n #f))
  ;; A write! that answers 0 for its first 5 calls: how many calls?
  (let ([n (length (calls))] [zeros 5])
    (put-bytevector p (bytes 10))
    (set-answer! (lambda (start count)
                   (if (fx> zeros 0) (begin (set! zeros (fx- zeros 1)) 0) count)))
    (flush-output-port p)
    (say "flush 10, write! answers 0 five times: write! calls ~s" (fx- (length (calls)) n)))
  ;; A write! that takes 4 at most.
  (let ([n (length (calls))])
    (put-bytevector p (bytes 10))
    (set-answer! (lambda (start count) (fxmin count 4)))
    (flush-output-port p)
    (report "flush 10, write! takes 4 at most" p calls n #f)
    (set-answer! (lambda (start count) count)))
  (let ([n (length (calls))] [buf (binary-port-output-buffer p)])
    (put-bytevector p (bytes 5))
    (close-port p)
    (report "close-port with 5 buffered" p calls n #f)
    (say "close-port with 5 buffered: write! was handed the port's buffer as it was before the close: ~s"
         (eq? (vector-ref (list-ref (calls) n) 2) buf))
    (say "close-port with 5 buffered: close calls ~s" (closes))
    (close-port p)
    (say "close-port again: close calls ~s, write! calls ~s" (closes) (fx- (length (calls)) n))))
(say "C4 done")

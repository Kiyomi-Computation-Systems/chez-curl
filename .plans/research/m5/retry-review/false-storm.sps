(import (chezscheme) (curl) (http-client) (only (curl private transfer) transfers-started))
;; A storm of timer ticks, each raising continuably, once the call's transfer
;; has started (so request building, outside the drive, is not stormed).
;; MODE fresh: each tick raises a fresh object; constant: the same symbol.
(define mode (string->symbol (car (command-line-arguments))))
(define runs (string->number (cadr (command-line-arguments))))
(define url (caddr (command-line-arguments)))
(define s (make-http-session 'timeout-ms 5000))
(define sent 0)
(define reached 0)
(define (tick? e) (or (not e) (eq? e (quote tick)) (and (pair? e) (eq? (car e) (quote tick)))))
(define period 1)
(define base 0)
(define active #f)
(define in-raise #f)
(define tally '())
(define (bump! k)
  (let ((a (assoc k tally)))
    (if a (set-cdr! a (+ (cdr a) 1)) (set! tally (cons (cons k 1) tally)))))
(define (handler)
  (cond
   ((not active) #f)
   (in-raise (unless (eq? mode (quote prearm)) (set-timer period)))
   ((= (transfers-started) base)
      (set-timer period))
   (else
      (begin
        (set! sent (+ sent 1))
        (let ((v (dynamic-wind (lambda () (set! in-raise #t)) (lambda () (when (eq? mode (quote prearm)) (set-timer (+ 3 (mod sent 40)))) (raise-continuable (case mode ((fresh) (list (quote tick))) ((false) #f) (else (quote tick))))) (lambda () (set! in-raise #f)))))
          (set-timer period)
          v)))))
(do ((i 0 (+ i 1))) ((= i runs))
  (set! base (transfers-started))
  (set! period (+ 1 (mod (* i 7) 97)))
  (timer-interrupt-handler handler)
  (let ((r (call/cc
            (lambda (k)
             (with-exception-handler (lambda (e) (set! reached (+ reached 1)) (quote resumed)) (lambda ()
             (with-exception-handler (lambda (e) (set! reached (+ reached 1)) (quote resumed)) (lambda ()
              (with-exception-handler
               (lambda (e)
                 (if (tick? e)
                     (begin (set! reached (+ reached 1)) 'resumed)
                     (begin (set! active #f) (k (list (quote raised) e)))))
               (lambda ()
                 (set! active #t)
                 (set-timer period)
                 (let ((v (http-get s url))) (set! active #f) v)))))))))))
    (set-timer 0)
    (bump! (cond ((not (and (pair? r) (eq? (car r) 'raised))) 'returned)
                 ((and (condition? (cadr r)) (http-exchange? (cadr r)) (curl-transfer-error? (cadr r))) 'compounded)
                 ((and (condition? (cadr r)) (curl-transfer-error? (cadr r))) 'raw-transfer-error)
                 ((and (condition? (cadr r)) (assertion-violation? (cadr r)) (who-condition? (cadr r)))
                  (list 'assertion (condition-who (cadr r))
                        (and (irritants-condition? (cadr r)) (condition-irritants (cadr r)))))
                 (else (list 'other (cadr r)))))))
(printf "mode ~s, runs ~s: ~s; ticks sent ~s, reached the caller ~s, lost ~s~%"
        mode runs tally sent reached (- sent reached))
(http-session-close s)

(import (chezscheme) (curl) (http-client))
(define port (car (command-line-arguments)))
(define (now-ms) (let ((t (current-time 'time-monotonic))) (+ (* (time-second t) 1000) (div (time-nanosecond t) 1000000))))
(define s (make-http-session 'timeout-ms 3000 'retry (make-http-retry 'backoff-ms 1000 'max-backoff-ms 5000 'jitter #f)))
(define t0 (now-ms))
(define r (guard (e (#t e)) (http-post s (string-append "http://127.0.0.1:" port "/order") 'body "item=1")))
(define took (- (now-ms) t0))
(if (condition? r)
    (printf "raised after ~s ms: code ~s, request-size ~s, http-timeout? ~s, exchange ~s~%"
            took (and (curl-transfer-error? r) (curl-transfer-error-code r))
            (and (curl-transfer-error? r) (curl-transfer-error-request-size r))
            (http-timeout? r)
            (and (http-exchange? r) (list (http-exchange-method r) (http-exchange-transfers r))))
    (printf "answered ~s~%" r))
(http-session-close s)

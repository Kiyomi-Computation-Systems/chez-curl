;; Where an engine expiry lands between http-parallel's entries: fuels FROM
;; to TO by STEP, printing the fuels whose outcome breaks the invariant
;; (a transfer after the expiry with the group made) and the classes seen.
(import (chezscheme) (curl) (http-client) (curl-testing)
        (only (curl private transfer) transfers-started) (curl private counters))
(define args (map string->number (command-line-arguments)))
(define (engine-run fuel thunk)
  (let* ((expired #f) (at #f) (result #f) (eng (make-engine thunk)))
    (eng fuel (lambda (left v) (set! result v))
         (lambda (next) (set! expired #t) (set! at (transfers-started))
           (next 1000000000 (lambda (left v) (set! result v)) (lambda (again) (set! result '(expired-twice))))))
    (list expired result (and at (- (transfers-started) at)))))
(define (class-of e)
  (cond ((and (condition? e) (http-group-error? e)) (http-group-error-reason e))
        ((and (condition? e) (assertion-violation? e) (who-condition? e) (eq? (condition-who e) 'call-with-parsed-url)) 're-entry)
        ((and (condition? e) (http-exchange? e)) 'failure)
        (else 'other)))
(call-with-origin
 (lambda (o)
   (let* ((f (origin-face o 'raw)) (n (cadddr args))
          (url (lambda (i) (string-append "http://" (car f) ":" (number->string (cdr f)) "/raw/retry?key=w-" (number->string i) "&fail=0&how=close")))
          (bad '()) (classes '()))
     (do ((fuel (car args) (+ fuel (caddr args)))) ((> fuel (cadr args)))
       (let* ((s (make-http-session 'timeout-ms 20000))
              (r (engine-run fuel (lambda () (guard (e (#t (class-of e))) (http-parallel s (map (lambda (i) (list 'get (url i))) (iota n))) 'responses)))))
         (http-session-close s)
         (unless (memq (cadr r) classes) (set! classes (cons (cadr r) classes)))
         (unless (or (eq? (cadr r) 'responses) (eqv? (caddr r) 0)) (set! bad (cons (list fuel r) bad)))))
     (printf "n ~a classes ~a bad ~a~%" n classes (reverse bad)))))

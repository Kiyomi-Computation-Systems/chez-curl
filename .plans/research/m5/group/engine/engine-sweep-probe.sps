;;; Where one engine expiry lands in http-parallel and in go, 4 calls each:
;;; each fuel's outcome class and transfers after the expiry. From the
;;; repository's root:  $CHEZ --libdirs src:tests:build/scheme-libs --program PROBE
(import (chezscheme) (curl) (http-client) (curl-testing)
        (only (curl private transfer) transfers-started) (curl private counters))
(define (engine-run fuel thunk)
  (let* ((expired #f) (at #f) (result #f) (eng (make-engine thunk)))
    (eng fuel (lambda (left v) (set! result v))
         (lambda (next) (set! expired #t) (set! at (transfers-started))
           (next 1000000000 (lambda (left v) (set! result v)) (lambda (again) (set! result '(expired-twice))))))
    (list expired result (and at (- (transfers-started) at)))))
(define (class-of e)
  (cond ((and (condition? e) (http-group-error? e)) (http-group-error-reason e))
        ((and (condition? e) (assertion-violation? e) (who-condition? e) (eq? (condition-who e) 'call-with-parsed-url)) 're-entry)
        ((and (condition? e) (http-exchange? e)) 'failure)
        (else (list 'other (if (condition? e) (and (who-condition? e) (condition-who e)) e)))))
(call-with-origin
 (lambda (o)
   (let* ((f (origin-face o 'raw))
          (url (lambda (i) (string-append "http://" (car f) ":" (number->string (cdr f)) "/raw/retry?key=sweep-" (number->string i) "&fail=0&how=close"))))
     (do ((fuel 250 (+ fuel 250))) ((> fuel 9000))
       (let* ((s (make-http-session 'timeout-ms 20000))
              (r (engine-run fuel (lambda ()
                                    (guard (e (#t (class-of e)))
                                      (let ((rs (http-parallel s (map (lambda (i) (list 'get (url i))) '(0 1 2 3)))))
                                        (if (for-all (lambda (r) (= 200 (http-response-status r))) rs) 'responses 'odd)))))))
         (http-session-close s)
         (printf "parallel ~a ~a~%" fuel r)))
     (do ((fuel 250 (+ fuel 250))) ((> fuel 6000))
       (let* ((s (make-http-session 'timeout-ms 20000))
              (r (engine-run fuel (lambda ()
                                    (guard (e (#t (list 'group (class-of e))))
                                      (call-with-request-group s
                                        (lambda (go)
                                          (let loop ((i 0) (made '()))
                                            (if (< i 4)
                                                (loop (+ i 1) (cons (guard (e (#t (class-of e))) (go 'get (url i))) made))
                                                (map (lambda (p) (if (symbol? p) p (guard (e (#t (class-of e))) (http-response-status (http-await p)))))
                                                     (reverse made)))))))))))
         (http-session-close s)
         (printf "go ~a ~a~%" fuel r))))))
(printf "counts ~a~%" (native-counts))

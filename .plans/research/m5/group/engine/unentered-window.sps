;;; Round 3 probe: where, by single ticks, an engine's expiry makes a
;;; resumed http-parallel raise a never-entered call's cancel (who
;;; http-parallel), on the real tree, with the suite's specs and engine-run.
;;; Coarse 200..9000 by 100 as the suite; then every tick from 150 below
;;; the first coarse cancel to 30 above it. One ROW per fine fuel: fuel,
;;; expired, class (reason who index), transfers after.
(import (chezscheme) (curl) (http-client) (curl-testing)
        (only (curl private transfer) transfers-started) (curl private counters))
(define (engine-run fuel thunk)
  (let* ((expired #f) (at #f) (result '(never-answered)) (eng (make-engine thunk)))
    (eng fuel (lambda (left v) (set! result v))
         (lambda (next) (set! expired #t) (set! at (transfers-started))
           (next 1000000000 (lambda (left v) (set! result v)) (lambda (again) (set! result '(expired-twice))))))
    (list expired result (and at (- (transfers-started) at)))))
(define urls #f)
(define (index-of u) (let loop ((i 0) (us urls)) (cond ((null? us) #f) ((equal? (car us) u) i) (else (loop (+ i 1) (cdr us))))))
(define (classify e)
  (cond ((and (condition? e) (http-group-error? e))
         (list (http-group-error-reason e) (and (who-condition? e) (condition-who e))
               (and (http-exchange? e) (index-of (http-exchange-url e)))))
        ((and (condition? e) (assertion-violation? e) (who-condition? e) (eq? (condition-who e) 'call-with-parsed-url)) '(re-entry))
        ((and (condition? e) (http-exchange? e)) '(failure))
        (else (list 'other))))
(define (in-order proc items)
  (let loop ((rest items) (answers '()))
    (if (null? rest) (reverse answers) (let ((a (proc (car rest)))) (loop (cdr rest) (cons a answers))))))
(call-with-origin
 (lambda (o)
   (let* ((f (origin-face o 'raw))
          (base (string-append "http://" (car f) ":" (number->string (cdr f))))
          (n 0)
          (run-at (lambda (fuel)
                    (set! n (+ n 1))
                    (set! urls (map (lambda (i) (string-append base "/raw/retry?key=uw-" (number->string n) "-" (number->string i) "&fail=0&how=close")) '(0 1 2 3)))
                    (let* ((s (make-http-session 'timeout-ms 20000))
                           (r (engine-run fuel (lambda ()
                                                 (guard (e (#t (classify e)))
                                                   (http-parallel s (map (lambda (u) (list 'get u)) urls))
                                                   '(responses))))))
                      (http-session-close s)
                      r)))
          (coarse (map (lambda (i) (* 100 i)) (map (lambda (i) (+ i 2)) (iota 89))))
          (coarse-rows (in-order run-at coarse))
          (first-cancel (let loop ((fs coarse) (rs coarse-rows))
                          (cond ((null? fs) #f)
                                ((eq? (car (cadr (car rs))) 'cancelled) (car fs))
                                (else (loop (cdr fs) (cdr rs)))))))
     (write (list 'FIRST-CANCEL first-cancel)) (newline)
     (for-each (lambda (fuel)
                 (let ((r (run-at fuel)))
                   (write (list 'ROW fuel (car r) (cadr r) (caddr r))) (newline)))
               (map (lambda (i) (+ (- first-cancel 150) i)) (iota 181))))))
(write (list 'counts (native-counts))) (newline)

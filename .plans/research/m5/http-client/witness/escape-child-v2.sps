;; The SIGINT child as tests/test-http-client.sps has it, written from its data:
;; (escape HOW WHEN SETTLED).
(import (chezscheme) (curl) (http-client) (only (http-client private call) http-session-engine) (only (curl private engine) call-with-engine-held curl-engine-live-count curl-engine-queued-count) (curl private counters))
(define url (car (command-line-arguments)))
(define (now-ms) (let ((t (current-time (quote time-monotonic)))) (+ (* (time-second t) 1000) (div (time-nanosecond t) 1000000))))
(define (held engine) (+ (curl-engine-queued-count engine) (curl-engine-live-count engine)))
(define session (make-http-session (quote timeout-ms) 30000))
(define engine (http-session-engine session))
(define lock (make-mutex))
(define holding #f)
(define letting-go #f)
(define released #f)
(define (flag get) (critical-section (with-mutex lock (get))))
(fork-thread (lambda () (call-with-engine-held engine (lambda () (critical-section (with-mutex lock (set! holding #t))) (sleep (make-time (quote time-duration) 0 3)) (critical-section (with-mutex lock (set! letting-go #t))))) (critical-section (with-mutex lock (set! released #t)))))
(let spin () (unless (flag (lambda () holding)) (sleep (make-time (quote time-duration) 1000000 0)) (spin)))
(define when-escaped #f)
(define how (call/cc (lambda (out) (keyboard-interrupt-handler (lambda () (set! when-escaped (if (flag (lambda () letting-go)) (quote after-release) (quote before-release))) (out (quote escaped)))) (write (list (quote ready) (get-process-id))) (newline) (flush-output-port (current-output-port)) (http-get session url) (quote returned))))
(keyboard-interrupt-handler void)
(let spin () (unless (flag (lambda () released)) (sleep (make-time (quote time-duration) 1000000 0)) (spin)))
(sleep (make-time (quote time-duration) 500000000 0))
(define settled (let ((deadline (+ (now-ms) 3000))) (let loop () (cond ((= (held engine) 0) (quote cancelled)) ((> (now-ms) deadline) (quote still-live)) (else (sleep (make-time (quote time-duration) 10000000 0)) (loop))))))
(write (list (quote escape) how when-escaped settled))
(newline)
(http-session-close session)
(write (list (quote counts) (native-counts)))
(newline)

#!r6rs
;;; build/m7s3b/urlprobe.sps: curl_url's answers to proxy URLs, with no
;;; flags and with CURLU_NON_SUPPORT_SCHEME (8), on the loaded libcurl.
;;; Each line: TAG FLAGS then set=CODE and, for a 0, each part with flags 0
;;; as (PART CODE TEXT).
(import (rnrs) (curl private native) (curl private constants) (curl private libcurl-info))

(define (bytes->latin1 bv) (list->string (map integer->char (bytevector->u8-list bv))))

(define (part-of handle part)
  (let-values (((code address) (curl-url-get handle part 0)))
    (if (= code 0)
        (let ((text (bytes->latin1 (c-string->bytevector address))))
          (curl-free address)
          (list code text))
        (list code))))

(define parts
  (list (cons 'url curlupart-url) (cons 'scheme curlupart-scheme) (cons 'user curlupart-user)
        (cons 'password curlupart-password) (cons 'host curlupart-host) (cons 'port curlupart-port)
        (cons 'path curlupart-path) (cons 'query curlupart-query) (cons 'fragment curlupart-fragment)))

(define (probe tag url flags)
  (let ((handle (curl-url)))
    (let ((code (call-with-c-string url (lambda (a) (curl-url-set handle curlupart-url a flags)))))
      (write (list tag flags 'set code
                   (if (= code 0)
                       (map (lambda (p) (cons (car p) (part-of handle (cdr p)))) parts)
                       '())))
      (newline)
      (when (= code 0)
        ;; set the port, then read the URL back
        (let ((pc (call-with-c-string "8080" (lambda (a) (curl-url-set handle curlupart-port a 0)))))
          (write (list tag flags 'port-set pc (part-of handle curlupart-url)))
          (newline))))
    (curl-url-cleanup handle)))

(display "libcurl ") (display (libcurl-info-version (loaded-libcurl))) (display " ") (display (loaded-tls-backend)) (newline)

(define cases
  '(("http" "http://127.0.0.1:3128")
    ("HTTP" "HTTP://127.0.0.1:3128")
    ("Https" "Https://127.0.0.1:3128")
    ("https-noport" "https://127.0.0.1")
    ("http-noport" "http://127.0.0.1")
    ("ftp" "ftp://127.0.0.1:3128")
    ("socks5" "socks5://127.0.0.1:3128")
    ("socks4a" "socks4a://127.0.0.1:3128")
    ("socks5h" "socks5h://127.0.0.1:3128")
    ("foo" "foo://127.0.0.1:3128")
    ("foo-noport" "foo://127.0.0.1")
    ("noscheme" "127.0.0.1:3128")
    ("noscheme-host" "localhost:3128")
    ("noscheme-bare" "localhost")
    ("empty" "")
    ("colon-slash" "http:/127.0.0.1:3128")
    ("long-s" "http\x17F;://127.0.0.1:3128")
    ("kelvin" "\x212A;ttp://127.0.0.1:3128")
    ("pct-zz-user" "http://u%zz:p@127.0.0.1:3128")
    ("pct-z-pass" "http://u:p%z@127.0.0.1:3128")
    ("pct-end-user" "http://u%:p@127.0.0.1:3128")
    ("pct-end-pass" "http://u:p%@127.0.0.1:3128")
    ("pct-1-user" "http://u%4:p@127.0.0.1:3128")
    ("pct-ok" "http://u%41:p%42@127.0.0.1:3128")
    ("raw-01-user" "http://u\x1;x:p@127.0.0.1:3128")
    ("raw-09-user" "http://u\x9;x:p@127.0.0.1:3128")
    ("raw-7F-user" "http://u\x7F;x:p@127.0.0.1:3128")
    ("raw-sp-user" "http://u x:p@127.0.0.1:3128")
    ("raw-tilde-user" "http://u~x:p@127.0.0.1:3128")
    ("raw-01-pass" "http://u:p\x1;x@127.0.0.1:3128")
    ("raw-sp-pass" "http://u:p x@127.0.0.1:3128")
    ("raw-utf8" "http://\xE9;l\xE8;ve:p\xE4;ss@127.0.0.1:3128")
    ("at" "http://@127.0.0.1:3128")
    ("colon-at" "http://:@127.0.0.1:3128")
    ("u-at" "http://u@127.0.0.1:3128")
    ("u-colon-at" "http://u:@127.0.0.1:3128")
    ("colon-p-at" "http://:p@127.0.0.1:3128")
    ("two-colons" "http://u:p:q@127.0.0.1:3128")
    ("path" "http://127.0.0.1:3128/a")
    ("path-slash" "http://127.0.0.1:3128/")
    ("query" "http://127.0.0.1:3128?q")
    ("empty-query" "http://127.0.0.1:3128/?")
    ("fragment" "http://127.0.0.1:3128#f")
    ("empty-fragment" "http://127.0.0.1:3128/#")
    ("pct-host" "http://caf%E9.example:3128")
    ("ipv6" "http://[::1]:3128")
    ("port0" "http://127.0.0.1:0")
    ("bad-port" "http://127.0.0.1:99999")
    ("foo-path" "foo://127.0.0.1:3128/a?b#c")
    ("foo-nohost" "foo:///x")
    ("socks5-user" "socks5://u:p@127.0.0.1:3128")))

(for-each (lambda (c) (probe (car c) (cadr c) 0) (probe (car c) (cadr c) 8)) cases)

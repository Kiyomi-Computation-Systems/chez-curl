(define-record-type plan (fields a b))
(define-record-type tok (fields p) (opaque #t))
(define-record-type (sess mk-sess sess?) (fields d) (sealed #t) (opaque #t))
(write (make-plan "url" '(basic "user" "s3cret"))) (newline)
(write (make-tok (make-plan 1 '(basic "user" "s3cret")))) (newline)
(write (mk-sess (make-plan 1 '(basic "user" "s3cret")))) (newline)
(display (format "~s" (make-tok (make-plan 1 '(basic "user" "s3cret"))))) (newline)
(guard (e (#t (display-condition e) (newline)))
  (assertion-violation 'w "a token's port is made once" (make-tok (make-plan 1 '(basic "user" "s3cret")))))
(guard (e (#t (display-condition e) (newline)))
  (assertion-violation 'w "x" (make-plan 1 '(basic "user" "s3cret"))))
(display (print-level)) (newline)

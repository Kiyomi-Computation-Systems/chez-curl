+  (let ((request (make-curl-request target 'proxy proxy 'timeout-ms 5000)))
+    (let loop ((n 1) (re-entries '()) (ran #f))
+      (if (> n k)
+          (list (length re-entries) (take-up-to (reverse re-entries) 5) ran)
+          (let* ((token #f)
+                 (handled #f)
